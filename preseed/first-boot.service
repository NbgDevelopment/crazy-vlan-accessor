[Unit]
Description=Crazy VLAN Accessor first boot configuration
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/etc/crazy-vlan-accessor/config.env

[Service]
Type=oneshot
EnvironmentFile=/usr/local/etc/crazy-vlan-accessor/config.env
ExecStart=/bin/sh -ceu 'if [ "${AUTO_RUN:-0}" != "1" ]; then echo "crazy-vlan-accessor first boot automation disabled"; exit 0; fi; if [ -f /var/lib/crazy-vlan-accessor/first-boot.done ]; then echo "crazy-vlan-accessor first boot already completed"; exit 0; fi; mkdir -p /var/lib/crazy-vlan-accessor; /usr/local/lib/crazy-vlan-accessor/setup-host.sh --interface "${INTERFACE:?missing INTERFACE}" --hostname "${HOSTNAME:-crazy-vlan-accessor}" --admin-vlan "${ADMIN_VLAN:?missing ADMIN_VLAN}" --admin-cidr "${ADMIN_CIDR:?missing ADMIN_CIDR}" --admin-gateway "${ADMIN_GATEWAY:?missing ADMIN_GATEWAY}" --admin-dns "${ADMIN_DNS:?missing ADMIN_DNS}" --container-vlans "${CONTAINER_VLANS:?missing CONTAINER_VLANS}" --create-docker-networks; touch /var/lib/crazy-vlan-accessor/first-boot.done'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
