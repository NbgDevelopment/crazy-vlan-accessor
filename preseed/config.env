# Set to 1 to run the host bootstrap automatically on first boot.
# Leave at 0 to install only the OS and run setup-host.sh manually later.
AUTO_RUN=0

# Host bootstrap parameters consumed by preseed/first-boot.service.
HOSTNAME=crazy-vlan-accessor
INTERFACE=eno1
ADMIN_VLAN=10
ADMIN_CIDR=192.168.10.10/24
ADMIN_GATEWAY=192.168.10.1
ADMIN_DNS=192.168.10.1,1.1.1.1
CONTAINER_VLANS=20:192.168.20.0/24:192.168.20.1,30:192.168.30.0/24:192.168.30.1
